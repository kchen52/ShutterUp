<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- Pending capture file verified after TakePicture returns (SPEC §9). -->
    <cache-path
        name="pending"
        path="pending/" />
    <!-- Composed share cards (PNG). Dedicated path so capture temps are never shared. -->
    <cache-path
        name="share"
        path="share/" />
    <external-files-path
        name="ext_pictures"
        path="Pictures/" />
    <files-path
        name="thumbs"
        path="thumbs/" />
</paths>
